# Nothing here is required. Job search (LinkedIn, Indeed, Bayt) is free and needs no
# account, and jobs are scored by free keyword matching unless ChatGPT is switched on.

# --- ChatGPT: OFF by default (AI_MODE=basic is free) ---
# AI_MODE=chatgpt lets ChatGPT score each job and rewrite the CV for it, paid per use
# from an OpenAI API key (platform.openai.com/api-keys; ChatGPT Plus does not include it).
# AI_MODE=basic
OPENAI_API_KEY=
# OPENAI_MODEL_EVAL=gpt-5.6-luna
# OPENAI_MODEL_CV=                      # defaults to OPENAI_MODEL_EVAL

# --- Email digest: OFF by default ---
# Without it, every search keeps its matches, job links and tailored CVs in the web
# app, and you apply by hand. Set EMAIL_DIGEST=on to also email each digest through
# Brevo; only then are the settings below (down to EMAIL_CC_ATEF) needed.
# EMAIL_DIGEST=off

# Brevo - transactional email (API key, not the SMTP key)
BREVO_API_KEY=
EMAIL_FROM=sender@example.com           # must be a verified Brevo sender
EMAIL_TO=recipient@example.com          # comma-separated for several
# EMAIL_CC=
BREVO_SENDER_NAME=Executive Job Alerts

# Atef Fares (--candidate atef). His digest goes ONLY here - there is no fallback
# to EMAIL_TO, so one person's matches and CVs never reach the other.
EMAIL_TO_ATEF=
# EMAIL_CC_ATEF=

# Web app (python -m webapp): when set, the page asks for this password first
# APP_PASSWORD=

# --- optional tuning (defaults shown) ---
# CANDIDATE=ahmed                       # default candidate when --candidate is not given
# SOURCES=linkedin,indeed               # linkedin,indeed,bayt
# SEARCH_HOURS=24                       # how far back a daily search looks (the first one looks back 72)
# LOCATION=Saudi Arabia
# EMAIL_VERDICTS=strong,good            # which verdicts get a card in the email
# VERDICT_STRONG_MIN=75
# VERDICT_GOOD_MIN=70
# VERDICT_MODERATE_MIN=51
# CV_MIN_FIT_SCORE=70
# EVAL_BATCH_SIZE=8
# MAX_EVAL_ROUNDS=3
# LOG_LEVEL=INFO
